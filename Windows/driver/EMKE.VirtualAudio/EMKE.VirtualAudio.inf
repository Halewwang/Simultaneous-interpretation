[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=08/01/2026,1.0.0.2
CatalogFile=EMKE.VirtualAudio.cat
PnpLockDown=1

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
EMKE.VirtualAudio.sys=1

[DestinationDirs]
EMKE.CopyFiles=13

[Manufacturer]
%ManufacturerName%=EMKE,NTamd64.10.0...19045

[EMKE.NTamd64.10.0...19045]
%EMKE.VirtualAudio.DeviceDesc%=EMKE.VirtualAudio,ROOT\EMKEVIRTUALAUDIO

[EMKE.CopyFiles]
EMKE.VirtualAudio.sys

[EMKE.VirtualAudio.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=EMKE.CopyFiles
AddReg=EMKE.Device.AddReg

[EMKE.Device.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,EMKE.VirtualAudio.sys
HKR,,DriverAbi,0x00010001,0x00000001
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDescription%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDescription%

[EMKE.VirtualAudio.NT.Interfaces]
; Meeting render -> EMKE application capture.
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveMeetingSpeaker%,EMKE.I.WaveMeetingSpeaker
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveMeetingSpeaker%,EMKE.I.WaveMeetingSpeaker
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveMeetingSpeaker%,EMKE.I.WaveMeetingSpeaker
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyMeetingSpeaker%,EMKE.I.TopologyMeetingSpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMeetingSpeaker%,EMKE.I.TopologyMeetingSpeaker
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveAppSpeakerCapture%,EMKE.I.WaveAppSpeakerCapture
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveAppSpeakerCapture%,EMKE.I.WaveAppSpeakerCapture
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveAppSpeakerCapture%,EMKE.I.WaveAppSpeakerCapture
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyAppSpeakerCapture%,EMKE.I.TopologyAppSpeakerCapture
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyAppSpeakerCapture%,EMKE.I.TopologyAppSpeakerCapture

; EMKE application render -> meeting capture.
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveAppMicrophoneRender%,EMKE.I.WaveAppMicrophoneRender
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveAppMicrophoneRender%,EMKE.I.WaveAppMicrophoneRender
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveAppMicrophoneRender%,EMKE.I.WaveAppMicrophoneRender
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyAppMicrophoneRender%,EMKE.I.TopologyAppMicrophoneRender
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyAppMicrophoneRender%,EMKE.I.TopologyAppMicrophoneRender
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveMeetingMicrophone%,EMKE.I.WaveMeetingMicrophone
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveMeetingMicrophone%,EMKE.I.WaveMeetingMicrophone
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveMeetingMicrophone%,EMKE.I.WaveMeetingMicrophone
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyMeetingMicrophone%,EMKE.I.TopologyMeetingMicrophone
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMeetingMicrophone%,EMKE.I.TopologyMeetingMicrophone

[EMKE.VirtualAudio.NT.Services]
AddService=EMKEVirtualAudio,0x00000002,EMKE_Service

[EMKE_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\EMKE.VirtualAudio.sys

[EMKE.VirtualAudio.NT.HW]
AddReg=EMKE.Hardware.AddReg

[EMKE.Hardware.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x00010001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[EMKE.VirtualAudio.NT.Wdf]
KmdfService=EMKEVirtualAudio,EMKE_Wdf

[EMKE_Wdf]
KmdfLibraryVersion=1.31

[EMKE.I.WaveMeetingSpeaker]
AddReg=EMKE.I.WaveMeetingSpeaker.AddReg

[EMKE.I.WaveMeetingSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FriendlyMeetingSpeaker%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0,%PKEY_EMKE_EndpointRole%,0x00000000,%RoleMeetingSpeakerRender%

[EMKE.I.TopologyMeetingSpeaker]
AddReg=EMKE.I.TopologyMeetingSpeaker.AddReg

[EMKE.I.TopologyMeetingSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyMeetingSpeaker%

[EMKE.I.WaveAppSpeakerCapture]
AddReg=EMKE.I.WaveAppSpeakerCapture.AddReg

[EMKE.I.WaveAppSpeakerCapture.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FriendlyAppSpeakerCapture%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0,%PKEY_EMKE_EndpointRole%,0x00000000,%RoleAppSpeakerCapture%

[EMKE.I.TopologyAppSpeakerCapture]
AddReg=EMKE.I.TopologyAppSpeakerCapture.AddReg

[EMKE.I.TopologyAppSpeakerCapture.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyAppSpeakerCapture%

[EMKE.I.WaveAppMicrophoneRender]
AddReg=EMKE.I.WaveAppMicrophoneRender.AddReg

[EMKE.I.WaveAppMicrophoneRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FriendlyAppMicrophoneRender%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0,%PKEY_EMKE_EndpointRole%,0x00000000,%RoleAppMicrophoneRender%

[EMKE.I.TopologyAppMicrophoneRender]
AddReg=EMKE.I.TopologyAppMicrophoneRender.AddReg

[EMKE.I.TopologyAppMicrophoneRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyAppMicrophoneRender%

[EMKE.I.WaveMeetingMicrophone]
AddReg=EMKE.I.WaveMeetingMicrophone.AddReg

[EMKE.I.WaveMeetingMicrophone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FriendlyMeetingMicrophone%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0,%PKEY_EMKE_EndpointRole%,0x00000000,%RoleMeetingMicrophoneCapture%

[EMKE.I.TopologyMeetingMicrophone]
AddReg=EMKE.I.TopologyMeetingMicrophone.AddReg

[EMKE.I.TopologyMeetingMicrophone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyMeetingMicrophone%

