{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emke:contracts:v1:translation-events",
  "title": "EMKE Translation Events v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "session"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "session.update" },
        "session": {
          "type": "object",
          "required": ["audio"],
          "properties": {
            "audio": {
              "type": "object",
              "required": ["output"],
              "properties": {
                "output": {
                  "type": "object",
                  "required": ["language"],
                  "properties": {
                    "language": { "enum": ["zh", "en", "de"] }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "audio"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "session.input_audio_buffer.append" },
        "audio": { "type": "string", "contentEncoding": "base64" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "session.close" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "session.created" },
        "session": { "type": "object" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "session.updated" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "delta"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "session.output_audio.delta" },
        "delta": { "type": "string", "contentEncoding": "base64" },
        "sample_rate": { "const": 24000 },
        "channels": { "const": 1 },
        "format": { "const": "pcm16" },
        "elapsed_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "delta"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "session.input_transcript.delta" },
        "delta": { "type": "string" },
        "elapsed_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "delta"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "session.output_transcript.delta" },
        "delta": { "type": "string" },
        "elapsed_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "error"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "error" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "const": "session.closed" }
      },
      "additionalProperties": false
    }
  ]
}
